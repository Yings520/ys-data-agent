#!/usr/bin/env bash
set -euo pipefail

# Ralph TUI 0.12 still emits the removed Codex `--full-auto` flag. The project
# disables that adapter mode and uses the current global approval flag instead.
# Do not route JSONL through RTK here: Ralph must receive Codex's raw event stream.
prompt_file="$(mktemp "${TMPDIR:-/tmp}/ysda-codex-ralph.XXXXXX")"
last_message_file="$(mktemp "${TMPDIR:-/tmp}/ysda-codex-ralph-last.XXXXXX")"
trap 'rm -f "$prompt_file" "$last_message_file"' EXIT
cat > "$prompt_file"

dispatch_feature="$(
  sed -n 's/^Feature: \([a-z0-9][a-z0-9._-]*\)$/\1/p' "$prompt_file" | head -n 1
)"
dispatch_task_id="$(
  sed -n 's/^- ID: \([A-Za-z0-9.][A-Za-z0-9.]*\)$/\1/p' "$prompt_file" | head -n 1
)"

unset CC_SDD_DISPATCH_FEATURE CC_SDD_DISPATCH_TASK_ID

if [[ -z "$dispatch_feature" && -z "$dispatch_task_id" ]]; then
  : # Ralph availability probes are not task dispatches.
elif [[ ! "$dispatch_feature" =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
  [[ ! "$dispatch_task_id" =~ ^([0-9]+(\.[0-9]+)*|VALIDATE)$ ]]; then
  printf '%s\n' 'codex-ralph: invalid cc-sdd dispatch prompt' >&2
  exit 2
else
  export CC_SDD_DISPATCH_FEATURE="$dispatch_feature"
  export CC_SDD_DISPATCH_TASK_ID="$dispatch_task_id"

  mandatory_policies=(
    ".ysda/agents/rust-engineer.md"
    ".ysda/agents/code-change-pr-workflow.md"
  )
  policy_root="${CC_SDD_POLICY_ROOT:-$PWD}"
  for policy in "${mandatory_policies[@]}"; do
    policy_path="${policy_root}/${policy}"
    if [[ ! -r "$policy_path" ]]; then
      printf '%s\n' 'codex-ralph: mandatory policy unavailable' >&2
      exit 2
    fi
    printf '\n## Mandatory Execution Policy: %s\n\n' "$policy" >> "$prompt_file"
    while IFS= read -r policy_line || [[ -n "$policy_line" ]]; do
      printf '%s\n' "$policy_line" >> "$prompt_file"
    done < "$policy_path"
  done
fi

# Ralph TUI 0.12 always emits the legacy --sandbox option. That option disables
# Codex permission profiles, so replace it with a workspace-scoped profile that
# also permits loopback listeners used by Wiremock and other integration tests.
codex_arguments=()
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --sandbox)
      if [[ "$#" -lt 2 ]]; then
        printf '%s\n' 'codex-ralph: missing sandbox value' >&2
        exit 2
      fi
      shift 2
      ;;
    --sandbox=*)
      shift
      ;;
    *)
      codex_arguments+=("$1")
      shift
      ;;
  esac
done

codex_arguments+=(
  -c 'default_permissions="ralph_local_tests"'
  -c 'permissions.ralph_local_tests.extends=":workspace"'
  -c 'permissions.ralph_local_tests.network.enabled=true'
  -c 'permissions.ralph_local_tests.network.allow_local_binding=true'
)

argument_count="${#codex_arguments[@]}"
if [[ "$argument_count" -gt 0 ]] &&
  [[ "${codex_arguments[argument_count - 1]}" == "-" ]]; then
  unset 'codex_arguments[argument_count - 1]'
  codex_arguments+=(--output-last-message "$last_message_file" -)
else
  codex_arguments+=(--output-last-message "$last_message_file")
fi

codex_status=0
codex -a never "${codex_arguments[@]}" < "$prompt_file" || codex_status="$?"
if [[ "$codex_status" -ne 0 ]]; then
  exit "$codex_status"
fi

if [[ -n "$dispatch_feature" ]] &&
  grep -Eq '^[[:space:]]*STATUS:[[:space:]]+BLOCKED([[:space:]]|$)' "$last_message_file"; then
  exit 75
fi

exit 0
